# Cloudflare caching rules (copied into "public" with the rest of the site).
# Photos rarely change; when one does, give it a new file name.
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/film/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800

# CSS and JS change with updates: browsers check with the server on every visit
# (an unchanged file comes back as a tiny "not modified"). The build also adds ?v=<fingerprint>.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate
